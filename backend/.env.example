# FPO SaaS Platform — Backend Environment Configuration
# Copy to .env and fill in real values. NEVER commit .env with real secrets.

NODE_ENV=development
PORT=3000

# PostgreSQL (Master SRS v1.1 §4.1 — frozen: PostgreSQL 15+, shared-DB + tenant_id + RLS)
DATABASE_URL=postgres://fpo_app_user:changeme@localhost:5432/fpo_saas
DATABASE_SSL=false

# JWT / Auth (Priority #1 v1.2 — secure credential lifecycle)
JWT_ACCESS_SECRET=change-me-32-chars-minimum-random-value
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-different-32-chars-minimum
JWT_REFRESH_EXPIRES_IN=7d

# Rate limiting (OWASP-aligned, per project instructions)
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=100

# Redis (Master SRS v1.1 §4.1 — frozen: Redis + BullMQ for queues/background workers)
REDIS_URL=redis://localhost:6379

# CORS — explicit allowlist only. Empty by default = no cross-origin access
# (fail-safe). Add real tenant-portal/frontend origins as they are known.
# Comma-separated, no wildcard. Example for local dev:
# ALLOWED_ORIGINS=http://localhost:5173
ALLOWED_ORIGINS=

# Priority #18 platform control-plane. No universal business defaults are invented.
# Set explicit positive values before enabling the corresponding workflow.
PLATFORM_RECOVERY_REQUEST_TTL_HOURS=
PLATFORM_SUPPORT_ACCESS_MAX_MINUTES=


# Priority #1 immutable FPO-Code numbering engine.
# No universal literal format is frozen; deployment MUST explicitly choose one.
# Supported token: {seq} or {seq:N}. Example:
FPO_CODE_FORMAT=FPO-{seq:6}
